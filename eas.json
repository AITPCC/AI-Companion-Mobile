{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.qinshihuang.ai"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.qinshihuang.ai"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6777379501"
      }
    }
  }
}
